{
  "doctype": "DocType",
  "name": "JN File Revision",
  "module": "Workbench",
  "engine": "InnoDB",
  "field_order": [
    "record_id",
    "inquiry",
    "document",
    "version_number",
    "version_key",
    "file",
    "filename",
    "sha256",
    "file_size",
    "uploaded_by",
    "change_note"
  ],
  "fields": [
    {
      "fieldname": "record_id",
      "label": "稳定编号",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "read_only": 1
    },
    {
      "fieldname": "inquiry",
      "label": "关联询价",
      "fieldtype": "Link",
      "options": "JN Inquiry",
      "reqd": 1
    },
    {
      "fieldname": "document",
      "label": "资料",
      "fieldtype": "Link",
      "options": "JN Document",
      "reqd": 1
    },
    {
      "fieldname": "version_number",
      "label": "版本号",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "version_key",
      "label": "资料版本唯一键",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1
    },
    {
      "fieldname": "file",
      "label": "私有文件",
      "fieldtype": "Link",
      "options": "File",
      "read_only": 1
    },
    {
      "fieldname": "filename",
      "label": "原文件名",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "sha256",
      "label": "内容摘要",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "file_size",
      "label": "字节数",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "uploaded_by",
      "label": "上传人",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "change_note",
      "label": "版本说明",
      "fieldtype": "Small Text"
    }
  ],
  "allow_rename": 0,
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "select": 1
    },
    {
      "role": "JN Sales",
      "read": 1,
      "select": 1
    },
    {
      "role": "JN Technical",
      "read": 1,
      "select": 1
    }
  ],
  "autoname": "field:record_id",
  "sort_field": "modified",
  "sort_order": "DESC"
}
