  "allow_rename": 0,
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "select": 1
    },
    {
      "role": "JN Sales",
      "read": 1,
      "select": 1
    },
    {
      "role": "JN Technical",
      "read": 1,
      "select": 1
    }
  ],
  "autoname": "field:record_id",
  "sort_field": "modified",
  "sort_order": "DESC"
}
