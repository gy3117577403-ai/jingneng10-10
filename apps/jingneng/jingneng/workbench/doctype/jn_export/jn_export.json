{
  "doctype": "DocType",
  "name": "JN Export",
  "module": "Workbench",
  "engine": "InnoDB",
  "field_order": [
    "record_id",
    "inquiry",
    "inquiry_revision",
    "requested_by",
    "file",
    "manifest_json",
    "sha256"
  ],
  "fields": [
    {
      "fieldname": "record_id",
      "label": "稳定编号",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "read_only": 1
    },
    {
      "fieldname": "inquiry",
      "label": "关联询价",
      "fieldtype": "Link",
      "options": "JN Inquiry",
      "reqd": 1
    },
    {
      "fieldname": "inquiry_revision",
      "label": "导出时记录版本",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "requested_by",
      "label": "导出人",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "file",
      "label": "资料包",
      "fieldtype": "Link",
      "options": "File",
      "read_only": 1
    },
    {
      "fieldname": "manifest_json",
      "label": "导出清单",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "sha256",
      "label": "资料包摘要",
      "fieldtype": "Data"
    }
